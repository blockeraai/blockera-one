{
	"meta": {
		"title": "Install Blockera One theme from github artifact",
		"author": "https://blockera.ai/",
		"description": "Install and activate the Blockera One theme from a zip file stored in a GitHub artifact.",
		"categories": ["themes"]
	},
	"landingPage": "/wp-admin/admin.php?page=blockera-settings-dashboard",
	"preferredVersions": {
		"wp": "beta",
		"php": "8.0"
	},
	"features": {
		"networking": true
	},
	"steps": [
		{
			"step": "login"
		},
		{
			"step": "defineWpConfigConsts",
			"consts": {
				"BLOCKERA_TELEMETRY_OPT_IN_OFF": true
			}
		},
		{
			"step": "installTheme",
			"themeData": {
				"resource": "url",
				"url": "URL_PLACEMENT"
			}
		},
		{
			"step": "setSiteOptions",
			"options": {
				"blogname": "Blockera One Demo"
			}
		}
	]
}
