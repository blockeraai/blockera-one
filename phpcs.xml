<?xml version="1.0"?>
<!-- Generated from composer.json require (blockera/*) plus autoloader-coordinator. -->
<!-- project:bootstrap rewrites this file. -->
<ruleset name="WordPress Coding Standards for blockera-one">
    <description>Consumer ruleset: shared Blockera PHPCS + blockera-one text_domain. Scan the GP packages tree; exclude undeclared packages.</description>

    <rule ref="./packages/global-packages/packages/dev-tools/php/phpcs.xml"/>

    <config name="text_domain" value="blockera-one,blockera,default"/>
    <file>./packages/global-packages/packages</file>
    <exclude-pattern>./packages/global-packages/packages/(auth|auth-pro|blockera-pro|blockera-pro-admin|blocks-pro/core|console-pro|controls-pro|dev-cypress|dev-jest|dev-phpunit|dev-playwright|dev-tools|editor-pro|guard-pro|plugin-compatibility-pro|site-toolkit|validator-pro)/*</exclude-pattern>

    <arg name="cache" value=".cache/phpcs.json"/>
</ruleset>
